{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "memoria": {
      "type": "remote",
      "url": "https://infrastructureai.partcorp.ir/mcp/memoria",
      "enabled": true,
      "headers": {
        "x-memoria-max-content-length": "100000"
      }
    }
  },
  "provider": {
    "partAI": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Part AI",
      "options": {
        "baseURL": "https://freellm.partcorp.ir/v1",
        "apiKey": "{env:PART_AI_API_KEY}"
      },
      "models": {
        "minimax-m3-reasoning": {
          "name": "MiniMax M3 Reasoning"
        }
      }
    }
  }
}
