{
  "name": "rag-ingestion-layer",
  "version": "0.1.0",
  "private": true,
  "description": "RAG ingestion pipeline - repository adapter, file classification, markdown & code parsing, chunking, and KnowledgeChunk production for GitLab repositories.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ingestion": "tsx src/cli/run-ingestion.ts",
    "ingestion:incremental": "tsx src/cli/run-ingestion.ts --incremental"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "jszip": "^3.10.1",
    "remark-parse": "^11.0.0",
    "tar": "^7.5.22",
    "tree-sitter": "^0.21.1",
    "tree-sitter-javascript": "^0.21.4",
    "tree-sitter-typescript": "^0.21.2",
    "unified": "^11.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/tar": "^6.1.13",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vitest": "^2.1.3"
  }
}
