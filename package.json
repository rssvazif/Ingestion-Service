{
  "name": "rag-ingestion-layer",
  "version": "0.2.1",
  "private": true,
  "description": "RAG ingestion pipeline - repository adapter, file classification, markdown & code parsing, chunking, and KnowledgeChunk production for GitLab repositories.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "build": "echo 'No build step - pure ESM JavaScript.'",
    "test": "vitest run",
    "test:watch": "vitest",
    "ingestion": "node src/cli/run-ingestion.js",
    "ingestion:incremental": "node src/cli/run-ingestion.js --incremental",
    "ingestion:server": "node src/webhook/run-server.js",
    "ingestion:worker": "node src/worker/run-worker.js"
  },
  "dependencies": {
    "bullmq": "^6.3.8",
    "dotenv": "^17.4.2",
    "ioredis": "^6.0.0",
    "jszip": "^3.10.1",
    "remark-parse": "^11.0.0",
    "tar": "^7.5.22",
    "tree-sitter": "^0.21.1",
    "tree-sitter-javascript": "^0.21.4",
    "tree-sitter-typescript": "^0.21.2",
    "unified": "^11.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "vitest": "^2.1.3"
  }
}
