GITLAB_HOST=https://gitlab.partcorp.ir
GITLAB_TOKEN=
# Project id and branch are no longer set here. They are supplied per request:
#   - CLI:        --project-id=<id> --branch=<name>
#   - Webhook:    object.project.id + object_attributes.target_branch

# Webhook receiver (used by `npm run ingestion:server`)
INGESTION_WEBHOOK_PORT=3000
INGESTION_WEBHOOK_PATH=/ingest
# Optional shared secret. When set, requests must carry the same value in
# the `X-Gitlab-Token` header (matches GitLab's plain HTTP webhook secret).
INGESTION_WEBHOOK_SECRET=

# BullMQ queue + Worker (used by `npm run ingestion:server` and `npm run ingestion:worker`)
REDIS_URL=redis://127.0.0.1:6379
INGESTION_QUEUE_NAME=ingestion
# Jobs processed concurrently by a single worker process.
INGESTION_WORKER_CONCURRENCY=3
# Maximum processing attempts per job before it is marked failed.
INGESTION_JOB_ATTEMPTS=5
# Exponential backoff base delay in ms (delay = INGESTION_JOB_BACKOFF_DELAY * 2^attempt).
INGESTION_JOB_BACKOFF_DELAY=5000
# Optional backoff jitter (0..1) to spread retry bursts. 0 disables jitter.
INGESTION_JOB_BACKOFF_JITTER=0.2
# Retention (latest counts) for completed / failed jobs in Redis.
INGESTION_JOB_REMOVE_ON_COMPLETE=1000
INGESTION_JOB_REMOVE_ON_FAIL=5000
